# Controls what `gcloud run deploy --source=.` uploads to Cloud Build.
#
# Presence of this file makes gcloud ignore .gitignore entirely for the source upload, so
# every exclusion has to be listed here.
#
# config/site.yaml and context/* are excluded: on Cloud Run the service downloads them from
# the content bucket at startup (README "Content"), so the bucket is the only copy that
# counts and a stale local file can never end up in the image. context/.gitkeep stays so the
# Dockerfile's `COPY context/` still has a directory to copy.
config/site.yaml
context/*
!context/.gitkeep

.git/
.gitignore
.gcloudignore

__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

.pytest_cache/
.ruff_cache/
.mypy_cache/
tests/

.env
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
