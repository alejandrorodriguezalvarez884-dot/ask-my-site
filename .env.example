# Copy to .env and fill in real values. .env is gitignored - never commit real credentials.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of origins allowed to call this API from a browser (CORS).
# Use "*" only for local development - lock this down to your real site's origin(s) in production.
# Also read directly by deploy.sh (Cloud Run deploy) - no localhost fallback there, so this
# must be your real site's origin before you run `make deploy`.
ALLOWED_ORIGINS=http://localhost:4321

# GCP project to deploy to - read by deploy.sh, not by the app itself. Required, no default.
GCP_PROJECT_ID=

# Paths are relative to the working directory the service is run from (repo root locally,
# /app in the Docker image).
SITE_CONFIG_PATH=config/site.yaml
CONTEXT_DIR=context

# Cloud Storage bucket holding config/site.yaml and context/ (README "Content"). Used by
# deploy.sh and content.sh, which default it to <GCP_PROJECT_ID>-ask-my-site. If set here,
# the app also reads from the bucket when run locally instead of the two paths above - leave
# it empty to keep local runs on the local files (`make content-pull` fills them).
CONTENT_BUCKET=

# How many context chunks to retrieve per question.
TOP_K=5

# Off by default. When true, every chat exchange is written to Firestore (see "Persisting
# conversations" in the README) - needs Application Default Credentials, so leave this off
# for local dev unless you've run `gcloud auth application-default login`.
SAVE_CONVERSATIONS=false
CHAT_STORE_COLLECTION=conversations

LOG_LEVEL=INFO
